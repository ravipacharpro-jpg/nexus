{
  "$schema": "https://nexus.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "nexus-local": {
      "path": "~/.local/share/nexus",
      "description": "Contains nexus logs and data",
    },
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["node", ".nexus/scripts/browser-mcp-launcher.mjs", "--browser", "chromium", "--no-sandbox", "--headless", "--mobile", "--warmup"],
      "enabled": true,
      "timeout": 30000,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
